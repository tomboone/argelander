# Copy to .env for local dev. Every variable in the first two blocks is read by
# src/argelander/config.py (tests/test_env_example.py fails if a setting is missing here);
# the last block is read only by Compose.

# SQLAlchemy URL for the results database and job queue (psycopg 3 driver). `postgres` is
# the Compose service name, which is how the containers reach it; from the host the dev
# stack publishes it on localhost:${POSTGRES_PORT}.
DATABASE_URL=postgresql+psycopg://argelander:argelander@postgres:5432/argelander

# The Parquet light-curve Cache, the evidence plots, and the astropy/astroquery download
# directory (not the Cache in the glossary sense). In prod all three live on the USB SSD.
# The image points XDG_CACHE_HOME at ASTRO_CACHE_DIR; move both together.
CACHE_DIR=data/cache
PLOTS_DIR=data/plots
ASTRO_CACHE_DIR=data/astropy

# Per-archive concurrency limits for the fetcher (local semaphores; see spec §5.1).
IRSA_CONCURRENCY=2
MAST_CONCURRENCY=2
GAIA_CONCURRENCY=1
ASASSN_CONCURRENCY=2
# Attempts per archive call within one fetch Job, retrying HTTP 429/5xx and connection
# errors with backoff. Re-claiming a failed Job is the jobs table's max_attempts, not this.
FETCH_MAX_ATTEMPTS=3
# The fetch worker: fetch Jobs claimed at once (Gaia epoch photometry is one request for
# all of them) and the idle sleep in seconds when the queue is empty.
FETCH_BATCH_SIZE=10
FETCH_POLL_INTERVAL=60
# The analyze worker's idle sleep in seconds when no analyze Job waits.
ANALYZE_POLL_INTERVAL=60
# 1 lets the fetch and analyze workers run when CACHE_DIR has no .argelander-cache marker.
# Keep 0 in prod, so an unmounted USB SSD cannot leave the Cache filling the boot disk;
# compose.dev.yaml sets 1 for the dev containers, whose Cache is an ordinary directory.
ALLOW_UNMOUNTED_CACHE=0
# The fetch and analyze workers' wait at start, in seconds, for the database to reach the
# image's head revision (the api migrates on start), and how often they check. A worker still
# behind when it runs out exits non-zero, and its restart policy starts it again.
SCHEMA_WAIT_TIMEOUT=300
SCHEMA_WAIT_INTERVAL=5

# Compose only. Host ports for the dev stack (5432 is left to the shared localdev Postgres)
# and the dev Postgres password. Change it in DATABASE_URL above too, or drop DATABASE_URL
# from .env and let Compose build it from POSTGRES_PASSWORD.
POSTGRES_PORT=5433
JUPYTER_PORT=8888
API_PORT=8000
POSTGRES_PASSWORD=argelander
# Prod only: the USB SSD's mount point on the mini, holding cache/, plots/ and astropy/
# (deploy/README.md). The dev stack mounts the repo instead.
# USB_ROOT=/mnt/argelander
# Prod only: the api's tailscale sidecar (deploy/tailscale.md). A one-off auth key from the
# personal tailnet, tagged tag:app, blanked once the node has joined. TS_EXTRA_ARGS defaults
# to --advertise-tags=tag:app in compose.yaml; set it only to override that.
# TS_AUTHKEY=tskey-auth-...
# Prod only: the nightly backup's restic repository on Backblaze B2, through B2's S3 API, and a
# bucket-scoped B2 application key (deploy/restore.md). Keep RESTIC_PASSWORD in the password
# manager too: the backups cannot be read without it.
# RESTIC_REPOSITORY=s3:https://s3.us-east-005.backblazeb2.com/argelander-backup/postgres
# RESTIC_PASSWORD=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
