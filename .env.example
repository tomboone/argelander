# Copy to .env for local dev. Every variable is read by src/argelander/config.py.

# SQLAlchemy URL for the results database and job queue (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://argelander:argelander@localhost:5432/argelander

# The Parquet light-curve Cache, the evidence plots, and the astropy/astroquery download
# directory (not the Cache in the glossary sense). In prod all three live on the USB SSD.
CACHE_DIR=data/cache
PLOTS_DIR=data/plots
ASTRO_CACHE_DIR=data/astropy

# Per-archive concurrency limits for the fetcher (local semaphores; see spec §5.1).
IRSA_CONCURRENCY=2
MAST_CONCURRENCY=2
GAIA_CONCURRENCY=1
ASASSN_CONCURRENCY=2
